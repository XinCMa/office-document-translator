# Copy this file to .env and fill in your own key.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Translation requests run in parallel. Allowed range: 1-12; default: 6.
TRANSLATION_CONCURRENCY=6

# Local server settings
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
