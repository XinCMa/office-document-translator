# OpenAI-compatible model API. Replace all three values when using another provider.
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Optional display name shown in the local UI. Inferred from AI_API_BASE when empty.
AI_API_PROVIDER=

# Translation requests run in parallel. Allowed range: 1-12; default: 6.
TRANSLATION_CONCURRENCY=6

# Local server settings
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data

# Backward compatibility: existing DEEPSEEK_API_KEY, DEEPSEEK_API_BASE and
# DEEPSEEK_MODEL values are still accepted when the corresponding AI_* value is absent.
